{
  "bundleid": "com.motystudio.dashlane.note",
  "variablesconfig": {
    "item_id": { "src": "args[0]", "scriptenv": true },
    "clear_clipboard_after": { "src": "variable", "scriptenv": true },
    "dcli_path": { "src": "variable", "scriptenv": true }
  },
  "log": { "level": "warning", "internal": true },
  "window": {
    "title": "Dashlane note",
    "padding": 16,
    "root": {
      "type": "view",
      "layout": "inline",
      "direction": "vertical",
      "events": [
        {
          "triggers": "preload",
          "action": { "type": "script", "src": "scripts/note", "args": ["load", "{var:item_id}"] }
        }
      ],
      "components": [
        { "id": "card", "type": "label", "text": "Loading…" }
      ]
    }
  }
}
