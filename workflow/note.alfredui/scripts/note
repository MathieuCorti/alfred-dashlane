#!/usr/bin/python3
"""Secure note card: shows the note content and copies it.

Usage: note <command> <item_id>
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

from dashlane import cache, dcli, system, ui  # noqa: E402

RETURN = "↩︎"


def build(entry):
    try:
        content, error = dcli.read(entry["id"], "content"), None
    except Exception as exc:
        content, error = "", ui.error_text(exc)

    footer = {
        "type": "view",
        "layout": "border",
        "components": [
            {
                **ui.label(error or "", id="status", colour="systemRedColor" if error else ui.SECONDARY),
                "constraints": {"region": "centre", "position": "left", "stretch": "horizontal"},
            },
            {
                **ui.text_button("Copy note", ui.script_action("note", "copy", "{var:item_id}"), shortcut=RETURN, enabled=not error),
                "tooltip": "Copy the note content (↩)",
                "constraints": {"region": "right"},
            },
        ],
    }
    card = ui.inline(
        [
            ui.header("note.text", "systemYellowColor", entry["title"], "Secure note"),
            ui.separator(),
            {
                "id": "content",
                "type": "textarea",
                "text": content,
                "editable": False,
                "selectable": True,
                "font": {"size": 13},
                "constraints": {"size": {"height": 280}},
            },
            ui.separator(),
            footer,
        ],
        direction="vertical",
        spacing=14,
    )
    return {"replace": {"ids": {"card": card}}}


def main(command, item_id):
    entry = cache.find_note(item_id)
    if not entry:
        return ui.emit({"replace": {"ids": {"card": ui.label("This note is not in the local cache any more. Sync your vault and try again.")}}})
    if command == "load":
        return ui.emit(build(entry))
    if command == "copy":
        try:
            seconds = system.copy(dcli.read(item_id, "content"))
        except Exception as error:
            return ui.emit(ui.status(ui.error_text(error), error=True))
        return ui.emit(ui.status(f"Note copied · {system.clears_in(seconds) or 'clipboard is not cleared'}"))
    return ui.emit({})


if __name__ == "__main__":
    args = sys.argv[1:] + ["", ""]
    main(args[0], args[1])
